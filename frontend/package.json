{
  "name": "oneloop-frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test --disable-warning=ExperimentalWarning \"tests/**/*.test.*\"",
    "coverage": "c8 --all --include=\"src/**/*.js\" --reporter=lcov --reporter=text-summary --reports-dir=../target/coverage/frontend --temp-directory=../target/coverage/frontend/tmp node --test --disable-warning=ExperimentalWarning \"tests/**/*.test.*\"",
    "typecheck": "tsc -p jsconfig.json",
    "lint": "eslint src/ views/ --max-warnings 0"
  },
  "devDependencies": {
    "c8": "12.0.0",
    "eslint": "10.11.0",
    "globals": "16.5.0",
    "jsdom": "30.1.1",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  }
}
