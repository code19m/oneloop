# oneloop behind nginx. Replace the domain and the certificate paths, include
# this file in the http context of nginx.conf, and run nginx -t before you
# reload. Guide: https://code19m.github.io/oneloop/production.html#nginx
#
# Also set "worker_shutdown_timeout 30s;" in the main context of nginx.conf, so
# that old workers don't keep live-update and MCP streams open for long after a
# reload. Browsers reconnect by themselves.

upstream oneloop_app {
    # Keep the IPv4 address: a name such as localhost can resolve to an address
    # that oneloop doesn't listen on.
    server 127.0.0.1:8080;
    keepalive 16;
    # Let go of idle connections before oneloop does, even if
    # ONELOOP_TRUSTED_PROXIES doesn't name nginx: then oneloop closes them
    # after 15 seconds.
    keepalive_timeout 10s;
}

server {
    listen 80;
    listen [::]:80;
    server_name tasks.example.com;
    return 301 https://$host$request_uri;
}

server {
    # On nginx 1.25.1 or newer, use "listen 443 ssl;" and "http2 on;".
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name tasks.example.com;

    ssl_certificate /etc/ssl/certs/tasks.example.com/fullchain.pem;
    ssl_certificate_key /etc/ssl/private/tasks.example.com/privkey.pem;

    # oneloop sends its own Content-Security-Policy and Strict-Transport-Security
    # headers. Don't add, replace or hide them here.

    # Attachments are up to 25 MiB.
    client_max_body_size 27m;

    proxy_http_version 1.1;
    # Keep the external port, which oneloop checks against ONELOOP_PUBLIC_URL.
    proxy_set_header Host $http_host;
    # Replace any value the client sent. oneloop trusts it only from the
    # addresses in ONELOOP_TRUSTED_PROXIES.
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header Connection "";
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;

    location / {
        proxy_pass http://oneloop_app;
        proxy_request_buffering off;
    }

    # Live updates: one long-lived stream for each open tab. Buffering delays them.
    location = /api/events {
        proxy_pass http://oneloop_app;
        proxy_buffering off;
        proxy_cache off;
    }

    # Compress the web app's files, but not API responses or live updates.
    location ~ "^/(?:$|index\.html$|(?:v/[a-f0-9]{64}/)?(?:src|views|styles|icons|vendor)/)" {
        proxy_pass http://oneloop_app;
        gzip on;
        gzip_comp_level 5;
        gzip_min_length 1024;
        gzip_proxied no-cache;
        gzip_vary on;
        gzip_types text/css text/javascript application/javascript application/json image/svg+xml;
    }

    # Optional: allow /healthz, which shows the version, only from your
    # monitoring network. Signed-in users still see the version in the app.
    # location = /healthz {
    #     allow 127.0.0.1;
    #     allow ::1;
    #     allow 192.0.2.0/24;
    #     deny all;
    #     proxy_pass http://oneloop_app;
    # }
}
